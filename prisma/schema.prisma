
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum ParticipationStatus {
  REGISTERED
  ATTENDED
  INCOMPLETE
  ABSENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceEvent {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceMethod {
  QR
  ORGANIZER
}

enum StarType {
  YELLOW
  GREEN
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HelperStatus {
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum RedemptionStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
  REJECTED
}

enum QrPurpose {
  CHECK_IN
  CHECK_OUT
}

model User {
  id            BigInt   @id @default(autoincrement())
  studentCode   String?  @unique @map("student_code") @db.VarChar(50)
  username      String   @db.Text
  email         String   @unique @db.VarChar(191)
  passwordHash  String?  @map("password_hash") @db.VarChar(255)
  firstname     String?  @db.Text
  lastname      String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  userRoles          UserRole[]
  organizedActivities Activity[] @relation("ActivityOrganizer")
  participations     Participation[]
  recordedAttendance AttendanceRecord[] @relation("AttendanceRecorder")
  receivedStars      StarTransaction[] @relation("StarRecipient")
  approvedStars      StarTransaction[] @relation("StarApprover")
  helperAssignments  HelperAssignment[] @relation("HelperStudent")
  createdAssignments HelperAssignment[] @relation("HelperAssigner")
  redemptions        RewardRedemption[]
  surveys            SurveyResponse[]
  auditLogs          AuditLog[] @relation("AuditActor")
  createdQrSessions  QrSession[] @relation("QrCreator")
  microsoftAccount MicrosoftAccount?
  microsoftLinkIntents MicrosoftLinkIntent[]

  @@map("users")
}

model MicrosoftAccount {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  tenantId  String   @map("tenant_id") @db.VarChar(36)
  objectId  String   @map("object_id") @db.VarChar(36)
  label     String?  @db.VarChar(191)
  linkedAt  DateTime @default(now()) @map("linked_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, objectId])
  @@map("microsoft_accounts")
}

model MicrosoftLinkIntent {
  id        String   @id @db.Char(64)
  userId    BigInt   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("microsoft_link_intents")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId BigInt @unique @map("user_id")
  roleId BigInt @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AcademicYear {
  id        BigInt             @id @default(autoincrement())
  code      String             @unique @db.VarChar(20)
  startsOn  DateTime           @map("starts_on") @db.Date
  endsOn    DateTime           @map("ends_on") @db.Date
  status    AcademicYearStatus @default(DRAFT)
  createdAt DateTime           @default(now()) @map("created_at") @db.DateTime(3)

  activities  Activity[]
  transactions StarTransaction[]
  rewardTiers RewardTier[]
  redemptions RewardRedemption[]

  @@index([status])
  @@map("academic_years")
}

model Activity {
  id             BigInt         @id @default(autoincrement())
  academicYearId BigInt         @map("academic_year_id")
  organizerId    BigInt         @map("organizer_id")
  title          String         @db.VarChar(191)
  description    String?        @db.Text
  location       String?        @db.VarChar(191)
  startsAt       DateTime       @map("starts_at") @db.DateTime(3)
  endsAt         DateTime       @map("ends_at") @db.DateTime(3)
  minMinutes     Int            @default(90) @map("min_minutes")
  status         ActivityStatus @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  organizer    User         @relation("ActivityOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  participations Participation[]
  helperAssignments HelperAssignment[]
  qrSessions QrSession[]
  surveys SurveyResponse[]

  @@index([academicYearId, status])
  @@index([startsAt])
  @@map("activities")
}

model Participation {
  id                BigInt         @id @default(autoincrement())
  activityId        BigInt         @map("activity_id")
  userId            BigInt         @map("user_id")
  status            ParticipationStatus @default(REGISTERED)
  eligibilityStatus ReviewStatus   @default(PENDING) @map("eligibility_status")
  attendedMinutes   Int?           @map("attended_minutes")
  reviewDueAt       DateTime?      @map("review_due_at") @db.DateTime(3)
  reviewedAt        DateTime?      @map("reviewed_at") @db.DateTime(3)
  reviewedBy        BigInt?        @map("reviewed_by")
  reviewNote        String?        @map("review_note") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]
  starTransactions StarTransaction[]

  @@unique([activityId, userId])
  @@index([userId, eligibilityStatus])
  @@index([eligibilityStatus, reviewDueAt])
  @@map("participations")
}

model AttendanceRecord {
  id              BigInt           @id @default(autoincrement())
  participationId BigInt           @map("participation_id")
  eventType       AttendanceEvent  @map("event_type")
  method          AttendanceMethod
  occurredAt      DateTime          @map("occurred_at") @db.DateTime(3)
  recordedBy      BigInt            @map("recorded_by")
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Restrict)
  recorder User @relation("AttendanceRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@unique([participationId, eventType])
  @@index([occurredAt])
  @@map("attendance_records")
}

model HelperAssignment {
  id             BigInt       @id @default(autoincrement())
  activityId     BigInt       @map("activity_id")
  userId         BigInt       @map("user_id")
  assignedBy     BigInt       @map("assigned_by")
  status         HelperStatus @default(ASSIGNED)
  description    String?      @db.Text
  completedAt    DateTime?    @map("completed_at") @db.DateTime(3)
  reviewDueAt    DateTime?    @map("review_due_at") @db.DateTime(3)
  reviewedAt     DateTime?    @map("reviewed_at") @db.DateTime(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  student User @relation("HelperStudent", fields: [userId], references: [id], onDelete: Restrict)
  assigner User @relation("HelperAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)
  starTransactions StarTransaction[]

  @@unique([activityId, userId])
  @@index([userId, status])
  @@map("helper_assignments")
}

model StarTransaction {
  id               BigInt            @id @default(autoincrement())
  userId           BigInt            @map("user_id")
  academicYearId   BigInt            @map("academic_year_id")
  participationId  BigInt?           @map("participation_id")
  helperAssignmentId BigInt?         @map("helper_assignment_id")
  redemptionId     BigInt?           @unique @map("redemption_id")
  starType         StarType          @map("star_type")
  points           Int
  status           TransactionStatus @default(PENDING)
  reason           String?           @db.Text
  approvedBy       BigInt?           @map("approved_by")
  approvedAt       DateTime?         @map("approved_at") @db.DateTime(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation("StarRecipient", fields: [userId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  participation Participation? @relation(fields: [participationId], references: [id], onDelete: Restrict)
  helperAssignment HelperAssignment? @relation(fields: [helperAssignmentId], references: [id], onDelete: Restrict)
  approver User? @relation("StarApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  redemption RewardRedemption? @relation("RedemptionLedger", fields: [redemptionId], references: [id], onDelete: Restrict)

  @@unique([participationId, starType])
  @@unique([helperAssignmentId, starType])
  @@index([userId, academicYearId, status])
  @@index([academicYearId, starType, status])
  @@map("star_transactions")
}

model RewardTier {
  id             BigInt   @id @default(autoincrement())
  academicYearId BigInt   @map("academic_year_id")
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  imageData      Bytes?   @map("image_data") @db.MediumBlob
  imageMimeType  String?  @map("image_mime_type") @db.VarChar(50)
  imageUpdatedAt DateTime? @map("image_updated_at") @db.DateTime(3)
  costPoints     Int      @map("cost_points")
  stockQuantity  Int?     @map("stock_quantity")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  redemptions RewardRedemption[]

  @@unique([academicYearId, name])
  @@index([academicYearId, isActive, costPoints])
  @@map("reward_tiers")
}

model RewardRedemption {
  id             BigInt           @id @default(autoincrement())
  userId         BigInt           @map("user_id")
  academicYearId BigInt           @map("academic_year_id")
  rewardTierId   BigInt           @map("reward_tier_id")
  costPoints     Int              @map("cost_points")
  status         RedemptionStatus @default(PENDING)
  requestedAt    DateTime         @default(now()) @map("requested_at") @db.DateTime(3)
  redeemedAt     DateTime?        @map("redeemed_at") @db.DateTime(3)
  completedAt    DateTime?        @map("completed_at") @db.DateTime(3)
  note           String?          @db.Text
  requestId      String?          @unique @map("request_id") @db.VarChar(36)
  reviewedBy     BigInt?          @map("reviewed_by")
  reviewedAt     DateTime?        @map("reviewed_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  rewardTier RewardTier @relation(fields: [rewardTierId], references: [id], onDelete: Restrict)
  ledgerTransaction StarTransaction? @relation("RedemptionLedger")

  @@index([userId, academicYearId, requestedAt])
  @@index([academicYearId, status])
  @@map("reward_redemptions")
}

model QrSession {
  id          BigInt    @id @default(autoincrement())
  activityId  BigInt    @map("activity_id")
  createdBy   BigInt    @map("created_by")
  purpose     QrPurpose
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt   DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  creator User @relation("QrCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([activityId, purpose, expiresAt])
  @@map("qr_sessions")
}

model SurveyResponse {
  id         BigInt   @id @default(autoincrement())
  activityId BigInt   @map("activity_id")
  userId     BigInt   @map("user_id")
  answers    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([activityId, userId])
  @@map("survey_responses")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   BigInt?  @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

# Copy to .env.production on the deployment machine. Never commit real secrets.
# IIS serves HTTPS 443 using this project's hostname and SNI alongside other sites.
# PORT is the private Node.js port: ask the server administrator to reserve it.
NODE_ENV=production
PORT=3101
NEXTAUTH_URL="https://medexplore.medicine.up.ac.th"
# Generate once: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Keep the same secret across restarts/deployments; do not use this placeholder.
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
# Dedicated database/user for this project. Percent-encode special password characters.
DATABASE_URL="mysql://med_explore_app:REPLACE_DATABASE_PASSWORD@127.0.0.1:3306/med_explore"

# FIRST INSTALL ONLY: create roles/permissions and one ADMIN; no sample users.
# Use a real email and a unique 16+ character password (max 72 UTF-8 bytes).
# Remove these three values from the real file after db:bootstrap succeeds.
BOOTSTRAP_ADMIN_USERNAME="REPLACE_ADMIN_USERNAME"
BOOTSTRAP_ADMIN_EMAIL="REPLACE_ADMIN_EMAIL"
BOOTSTRAP_ADMIN_PASSWORD="REPLACE_ADMIN_PASSWORD"
